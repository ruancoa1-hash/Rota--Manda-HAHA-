# Modelo com exemplos, sem credenciais reais.
# Render: preencha os valores na aba Environment.
# Local: copie para .env e execute node --env-file=.env dist/server.js após o build.
NODE_ENV=production
PORT=10000
TZ=America/Sao_Paulo
# No Render, use /data e monte um Persistent Disk no mesmo caminho.
# Para testar no computador, use uma pasta local separada.
DATA_DIR=./.tmp-local-data
PANEL_USERS=admin@exemplo.com:TROQUE_ESTA_SENHA:admin
PANEL_ADMIN_EMAILS=admin@exemplo.com
# Gere uma chave: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PANEL_SESSION_SECRET=TROQUE_POR_UMA_CHAVE_ALEATORIA_DE_64_CARACTERES
BOT_PERFORMANCE_PROFILE=high
BOT_EAGER_WORKERS=true
OCR_GLOBAL_CONCURRENCY=1
OCR_TURBO_MODE=true
OCR_VARIANT_CONCURRENCY=2
UV_THREADPOOL_SIZE=4
KEEP_ALIVE_WHEN_MONITORING=false
DAILY_SESSION_RESET_ENABLED=false

# Backup R2 opcional: configure depois de preservar/restaurar os dados antigos.
# Endpoint sem o nome do bucket no final.
# R2_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
# R2_BUCKET=rota-mind-backups
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Para ler backups existentes, mantenha exatamente a chave usada para criá-los.
# R2_BACKUP_ENCRYPTION_KEY=
# R2_BACKUP_INTERVAL_MINUTES=15
# R2_BACKUP_RETENTION_DAYS=30
